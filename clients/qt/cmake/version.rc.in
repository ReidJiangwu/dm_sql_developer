#include <windows.h>
#pragma code_page(65001)

IDI_APP_ICON ICON DISCARDABLE "@CMAKE_CURRENT_SOURCE_DIR@/resources/icons/app.ico"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @REID_APP_VERSION_RC@
 PRODUCTVERSION @REID_APP_VERSION_RC@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Gzyd\0"
            // Explicit wide Unicode escapes survive all resource input code pages.
            VALUE "FileDescription", L"\x5c0f\x667a\x8fbe\x68a6\x7ba1\x7406\x5de5\x5177\0"
            VALUE "FileVersion", "@REID_APP_VERSION@\0"
            VALUE "ProductName", L"\x5c0f\x667a\x8fbe\x68a6\x7ba1\x7406\x5de5\x5177\0"
            VALUE "ProductVersion", "@REID_APP_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
