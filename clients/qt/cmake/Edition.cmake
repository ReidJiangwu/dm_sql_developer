# Feature selection belongs to the build, not to user-writable application settings.
set(GZYD_EDITION "community" CACHE STRING "Product edition: internal or community")
set_property(CACHE GZYD_EDITION PROPERTY STRINGS internal community)
if(NOT GZYD_EDITION MATCHES "^(internal|community)$")
    message(FATAL_ERROR "Unsupported GZYD_EDITION: ${GZYD_EDITION}")
endif()
set(GZYD_EDITION_FILE "${CMAKE_CURRENT_SOURCE_DIR}/../../editions/${GZYD_EDITION}.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${GZYD_EDITION_FILE}")
file(READ "${GZYD_EDITION_FILE}" GZYD_EDITION_JSON)
string(JSON GZYD_PROFILE_NAME GET "${GZYD_EDITION_JSON}" edition)
if(NOT GZYD_PROFILE_NAME STREQUAL GZYD_EDITION)
    message(FATAL_ERROR "Edition profile name does not match its selected configuration")
endif()
foreach(feature erp internalHub)
    string(JSON feature_type TYPE "${GZYD_EDITION_JSON}" features ${feature})
    if(NOT feature_type STREQUAL "BOOLEAN")
        message(FATAL_ERROR "Edition features must use JSON booleans: ${feature}")
    endif()
    string(JSON enabled GET "${GZYD_EDITION_JSON}" features ${feature})
    if(enabled)
        set(GZYD_FEATURE_${feature} 1)
    else()
        set(GZYD_FEATURE_${feature} 0)
    endif()
endforeach()
if(GZYD_EDITION STREQUAL "community" AND (GZYD_FEATURE_erp OR GZYD_FEATURE_internalHub))
    message(FATAL_ERROR "Community builds cannot enable private features")
endif()
add_compile_definitions(GZYD_FEATURE_ERP=${GZYD_FEATURE_erp}
    GZYD_FEATURE_INTERNAL_HUB=${GZYD_FEATURE_internalHub})
if(GZYD_FEATURE_erp)
    include_directories("${CMAKE_CURRENT_SOURCE_DIR}/../../private/erp")
endif()
